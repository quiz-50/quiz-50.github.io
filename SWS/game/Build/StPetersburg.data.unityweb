vec4 u_xlat0;
bool u_xlatb0;
vec4 u_xlat1;
vec4 u_xlat2;
vec4 u_xlat3;
vec4 u_xlat4;
ivec4 u_xlati4;
vec4 u_xlat5;
vec4 u_xlat6;
vec4 u_xlat7;
