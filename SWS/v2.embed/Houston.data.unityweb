    u_xlat9.x = u_xlat1.y;
    u_xlat9.y = u_xlat2.y;
    u_xlat9.z = u_xlat6.y;
    u_xlat9.w = u_xlat7.y;
    u_xlat7.x = u_xlat1.z;
