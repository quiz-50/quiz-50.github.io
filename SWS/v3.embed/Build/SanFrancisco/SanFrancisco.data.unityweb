    u_xlat3 = vec4(uintBitsToFloat(inSkin_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 0]), uintBitsToFloat(inSkin_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 1]), uintBitsToFloat(inSkin_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 2]), uintBitsToFloat(inSkin_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 3]));
