    u_xlat8.x = u_xlat4.x;
    u_xlat8.y = u_xlat5.x;
    u_xlat8.z = u_xlat6.x;
    u_xlat8.w = u_xlat7.x;
    u_xlat9.x = u_xlat4.y;
    u_xlat9.y = u_xlat5.y;
    u_xlat9.z = u_xlat6.y;
    u_xlat9.w = u_xlat7.y;
    u_xlat7.x = u_xlat4.z;
    u_xlat7.y = u_xlat5.z;
    u_xlat7.z = u_xlat6.z;
    u_xlat4.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(0 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(0 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(0 >> 2) + 2]));
    u_xlat5.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat3.w)].value[(16 >> 2) + 2]));
