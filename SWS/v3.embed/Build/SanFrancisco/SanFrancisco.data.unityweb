    u_xlat4.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati3.x].value[(0 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati3.x].value[(0 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati3.x].value[(0 >> 2) + 2]));
