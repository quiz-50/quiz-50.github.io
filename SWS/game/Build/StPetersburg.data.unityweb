    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 1] = floatBitsToUint(u_xlat2).y;
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 2] = floatBitsToUint(u_xlat2).z;
    return;
}
