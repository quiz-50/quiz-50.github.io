    u_xlat9.z = u_xlat6.y;
    u_xlat9.w = u_xlat7.y;
    u_xlat7.x = u_xlat4.z;
    u_xlat7.y = u_xlat5.z;
    u_xlat7.z = u_xlat6.z;
    u_xlat4.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(0 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(0 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati3.y].value[(0 >> 2) + 2]));
