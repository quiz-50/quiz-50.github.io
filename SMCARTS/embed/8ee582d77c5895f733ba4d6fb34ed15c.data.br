    u_xlat6.x = dot(u_xlat4, u_xlat3);
    u_xlat6.y = dot(u_xlat5, u_xlat3);
    u_xlat6.z = dot(u_xlat2, u_xlat3);
    u_xlat1.w = u_xlat0.w;
    u_xlat6.w = dot(u_xlat4.yzx, u_xlat1.xyw);
    u_xlat0.x = dot(u_xlat5.yzx, u_xlat1.xyw);
    u_xlat0.y = dot(u_xlat2.yzx, u_xlat1.xyw);
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2)] = uint(floatBitsToUint(u_xlat6.x));
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 1] = uint(floatBitsToUint(u_xlat6.y));
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 2] = uint(floatBitsToUint(u_xlat6.z));
