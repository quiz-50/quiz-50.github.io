    u_xlat12.x = u_xlat7.y;
    u_xlat12.y = u_xlat8.y;
    u_xlat12.z = u_xlat9.y;
    u_xlat12.w = u_xlat10.y;
    u_xlat10.x = u_xlat7.z;
    u_xlat10.y = u_xlat8.z;
