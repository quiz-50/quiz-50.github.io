    u_xlat4.y = dot(u_xlat6, u_xlat1);
    u_xlat4.z = dot(u_xlat3, u_xlat1);
    u_xlat1.x = dot(u_xlat5.xyz, u_xlat2.xyz);
    u_xlat1.y = dot(u_xlat6.xyz, u_xlat2.xyz);
    u_xlat1.z = dot(u_xlat3.xyz, u_xlat2.xyz);
    outVertices_buf[(u_xlati0 >> 2)] = uint(floatBitsToUint(u_xlat4.x));
    outVertices_buf[(u_xlati0 >> 2) + 1] = uint(floatBitsToUint(u_xlat4.y));
    outVertices_buf[(u_xlati0 >> 2) + 2] = uint(floatBitsToUint(u_xlat4.z));
