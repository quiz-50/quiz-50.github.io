    u_xlat4.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(16 >> 2) + 2]));
    u_xlat8.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(32 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(32 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(32 >> 2) + 2]));
    u_xlat9.xyw = vec3(uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati4.w].value[(48 >> 2) + 2]));
    u_xlat10.x = u_xlat3.x;
