    u_xlat8.xyw = vec3(uintBitsToFloat(inMatrices_buf[u_xlati3.w].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati3.w].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati3.w].value[(48 >> 2) + 2]));
    u_xlat9.x = u_xlat2.x;
    u_xlat9.y = u_xlat3.x;
    u_xlat9.z = u_xlat7.x;
