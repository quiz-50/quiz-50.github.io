    outVertices_buf[gl_GlobalInvocationID.x].value[(32 >> 2)] = floatBitsToUint(u_xlat2).x;
    outVertices_buf[gl_GlobalInvocationID.x].value[(32 >> 2) + 1] = floatBitsToUint(u_xlat2).y;
    return;
}
