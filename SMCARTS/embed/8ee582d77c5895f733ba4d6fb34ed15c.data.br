    u_xlat11.x = u_xlat4.x;
    u_xlat11.y = u_xlat5.x;
    u_xlat11.z = u_xlat6.x;
    u_xlat11.w = u_xlat10.x;
    u_xlat11 = u_xlat2.yyyy * u_xlat11;
