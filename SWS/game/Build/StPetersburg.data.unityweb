    u_xlat9.z = u_xlat8.z;
    u_xlat4 = u_xlat10 * u_xlat1.zzzz + u_xlat4;
    u_xlat5 = u_xlat11 * u_xlat1.zzzz + u_xlat5;
    u_xlat3 = u_xlat9 * u_xlat1.zzzz + u_xlat3;
    u_xlat1.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(0 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(0 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(0 >> 2) + 2]));
