    u_xlat8.z = u_xlat6.x;
    u_xlat8.w = u_xlat7.x;
    u_xlat9.x = u_xlat4.y;
    u_xlat9.y = u_xlat5.y;
    u_xlat9.z = u_xlat6.y;
    u_xlat9.w = u_xlat7.y;
