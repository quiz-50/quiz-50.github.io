    u_xlat9.xyw = vec3(uintBitsToFloat(inMatrices_buf[u_xlati2.y].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati2.y].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati2.y].value[(48 >> 2) + 2]));
