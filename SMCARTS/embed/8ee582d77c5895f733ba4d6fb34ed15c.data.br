    u_xlat10.z = u_xlat6.z;
    u_xlat4 = u_xlat3.yyyy * u_xlat10;
    u_xlat5 = u_xlat8 * u_xlat3.xxxx + u_xlat11;
    u_xlat6 = u_xlat9 * u_xlat3.xxxx + u_xlat12;
    u_xlat3 = u_xlat7 * u_xlat3.xxxx + u_xlat4;
    u_xlat1.w = 1.0;
